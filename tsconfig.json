{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,
    "resolveJsonModule": true
  },
  "include": ["server", "shared", "web", "electron", "test", "vite.config.ts"]
}
