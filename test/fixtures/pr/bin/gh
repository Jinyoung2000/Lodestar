#!/usr/bin/env node
// 시험용 가짜 gh. 호출 인자와 stdin 을 $FAKE_GH_LOG 에 한 줄씩 남기고, GraphQL 연산 이름이나 REST 경로로 data.json 의 응답을 돌려준다.
// 실제 GitHub 에는 아무것도 보내지 않는다.
import { appendFileSync, existsSync, readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const args = process.argv.slice(2);
const stdin = await new Promise((resolve) => {
  // stdin 은 --input - 일 때만 읽는다(gh pr list 같은 호출은 stdin 을 닫지 않는다)
  if (process.stdin.isTTY || !args.includes("--input")) return resolve("");
  let text = "";
  process.stdin.on("data", (chunk) => (text += chunk));
  process.stdin.on("end", () => resolve(text));
});
const log = process.env.FAKE_GH_LOG;
if (log) appendFileSync(log, JSON.stringify({ args, stdin: stdin || null }) + "\n");
// FAKE_GH_DATA: 다른 시나리오 데이터(실제 커밋이 있는 임시 저장소에 맞춘 PR 등)를 쓸 때의 data.json 경로
const data = JSON.parse(readFileSync(process.env.FAKE_GH_DATA ?? join(dirname(fileURLToPath(import.meta.url)), "..", "data.json"), "utf8"));
const out = (value) => process.stdout.write(JSON.stringify(value));
const delay = Number(process.env.FAKE_GH_DELAY_MS ?? 0);
if (delay) await new Promise((r) => setTimeout(r, delay));

// 상태를 파일($FAKE_GH_STATE)에 두면 쓰기 뒤의 읽기에 그 결과가 보인다(대기 리뷰, 새 스레드, resolve, viewed). 없으면 늘 같은 응답.
const stateFile = process.env.FAKE_GH_STATE;
const blank = () => ({ replies: {}, pending: null, threads: [], comments: {}, deleted: [], resolved: {}, viewed: {}, reviews: [], issue: [], seq: 100 });
const state = stateFile && existsSync(stateFile) ? JSON.parse(readFileSync(stateFile, "utf8")) : blank();
const save = () => stateFile && writeFileSync(stateFile, JSON.stringify(state));
const me = { login: "me-test", avatarUrl: "https://avatars.example/me-test.png" };
const comment = (body, pending) => ({ id: `RC_new_${++state.seq}`, body, createdAt: new Date().toISOString(), lastEditedAt: null, viewerCanUpdate: true, viewerCanDelete: true, state: pending ? "PENDING" : "SUBMITTED", author: me, pullRequestReview: { id: pending ? state.pending.id : "PRR_x", state: pending ? "PENDING" : "COMMENTED" } });
const findThread = (id) => [...data.detail.repository.pullRequest.reviewThreads.nodes, ...state.threads].find((t) => t.id === id);

function detail() {
  const d = JSON.parse(JSON.stringify(data.detail));
  const pr = d.repository.pullRequest;
  pr.reviewThreads.nodes.push(...state.threads);
  for (const t of pr.reviewThreads.nodes) {
    t.comments.nodes.push(...(state.replies[t.id] ?? []));
    if (t.id in state.resolved) { t.isResolved = state.resolved[t.id]; t.viewerCanResolve = !t.isResolved; t.viewerCanUnresolve = t.isResolved; }
    t.comments.nodes = t.comments.nodes.filter((c) => !state.deleted.includes(c.id)).map((c) => (state.comments[c.id] ? { ...c, body: state.comments[c.id] } : c));
  }
  pr.reviewThreads.nodes = pr.reviewThreads.nodes.filter((t) => t.comments.nodes.length > 0);
  pr.timelineComments.nodes.push(...state.issue);
  pr.timelineComments.nodes = pr.timelineComments.nodes.filter((c) => !state.deleted.includes(c.id)).map((c) => (state.comments[c.id] ? { ...c, body: state.comments[c.id] } : c));
  pr.reviews.nodes.push(...state.reviews);
  pr.pendingReviews.nodes = state.pending ? [{ id: state.pending.id, comments: { totalCount: state.pending.comments } }] : [];
  applyScenario(d.repository, pr);
  return d;
}

// 머지 영역 시험용 상황. 상태 파일의 scenario(시험 중 바꿀 수 있다) 또는 $FAKE_GH_SCENARIO, 쉼표로 여럿.
// draft, conflict, blocked, behind, unknown, nowrite, rebaseonly, closed, autodelete(저장소가 머지 뒤 head 브랜치를 지움)
function applyScenario(repo, pr) {
  const names = String(state.scenario ?? process.env.FAKE_GH_SCENARIO ?? "").split(",").filter(Boolean);
  const has = (name) => names.includes(name);
  if (has("draft") && !state.ready) Object.assign(pr, { isDraft: true, mergeStateStatus: "DRAFT" });
  if (has("conflict")) Object.assign(pr, { mergeable: "CONFLICTING", mergeStateStatus: "DIRTY" });
  if (has("blocked")) {
    Object.assign(pr, { mergeStateStatus: "BLOCKED", reviewDecision: "REVIEW_REQUIRED" });
    pr.latestReviews.nodes = pr.latestReviews.nodes.map((n) => ({ ...n, state: "COMMENTED" }));
  }
  if (has("behind")) pr.mergeStateStatus = "BEHIND";
  if (has("unknown")) Object.assign(pr, { mergeable: "UNKNOWN", mergeStateStatus: "UNKNOWN" });
  if (has("nowrite")) repo.viewerPermission = "READ";
  if (has("rebaseonly")) Object.assign(repo, { mergeCommitAllowed: false, squashMergeAllowed: false, rebaseMergeAllowed: true });
  if (has("autodelete")) repo.deleteBranchOnMerge = true;
  if (has("closed")) pr.state = "CLOSED";
  if (state.merged) {
    pr.state = "MERGED";
    if (repo.deleteBranchOnMerge) pr.headRef = null;
  }
  if (state.refDeleted) pr.headRef = null;
}
function viewed() {
  const v = JSON.parse(JSON.stringify(data.viewed));
  for (const n of v.repository.pullRequest.files.nodes) if (n.path in state.viewed) n.viewerViewedState = state.viewed[n.path] ? "VIEWED" : "UNVIEWED";
  return v;
}
function mutate(op, input) {
  const startPending = () => (state.pending ??= { id: "PRR_pending", comments: 0 });
  if (op === "PrAddThread") {
    startPending();
    const c = comment(input.body, true);
    state.pending.comments++;
    state.threads.push({ id: `RT_new_${++state.seq}`, path: input.path, isResolved: false, isOutdated: false, line: input.line, originalLine: input.line, startLine: input.startLine ?? null, originalStartLine: input.startLine ?? null, diffSide: input.side, startDiffSide: input.startSide ?? null, viewerCanResolve: true, viewerCanUnresolve: false, comments: { nodes: [c] } });
  } else if (op === "PrReply") {
    if (input.pullRequestReviewId) { startPending(); state.pending.comments++; }
    (state.replies[input.pullRequestReviewThreadId] ??= []).push(comment(input.body, !!input.pullRequestReviewId));
  } else if (op === "PrResolve" || op === "PrUnresolve") state.resolved[input.threadId] = op === "PrResolve";
  else if (op === "PrSubmitReview" || op === "PrCreateReview") {
    for (const list of [...state.threads.map((t) => t.comments.nodes), ...Object.values(state.replies)]) for (const c of list) if (c.state === "PENDING") { c.state = "SUBMITTED"; c.pullRequestReview = { id: "PRR_sub", state: "COMMENTED" }; }
    state.reviews.push({ id: `PRR_sub_${++state.seq}`, state: { APPROVE: "APPROVED", REQUEST_CHANGES: "CHANGES_REQUESTED", COMMENT: "COMMENTED" }[input.event], body: input.body, createdAt: new Date().toISOString(), author: me });
    state.pending = null;
  } else if (op === "PrDiscardReview") {
    state.threads = state.threads.filter((t) => !t.comments.nodes.every((c) => c.state === "PENDING"));
    for (const k of Object.keys(state.replies)) state.replies[k] = state.replies[k].filter((c) => c.state !== "PENDING");
    state.pending = null;
  } else if (op === "PrEditReviewComment") state.comments[input.pullRequestReviewCommentId] = input.body;
  else if (op === "PrEditIssueComment") state.comments[input.id] = input.body;
  else if (op === "PrDeleteReviewComment" || op === "PrDeleteIssueComment") state.deleted.push(input.id);
  else if (op === "PrAddComment") state.issue.push({ ...comment(input.body, false), pullRequestReview: null });
  else if (op === "PrMarkViewed") state.viewed[input.path] = true;
  else if (op === "PrUnmarkViewed") state.viewed[input.path] = false;
  else if (op === "PrMerge") state.merged = input.mergeMethod;
  else if (op === "PrReadyForReview") state.ready = true;
  else if (op === "PrDeleteRef") state.refDeleted = true;
  save();
}

if (args[0] === "pr" && args[1] === "list") {
  // git.prs(입력창 위 PR 칩과 Checks 구역)가 부르는 gh pr list
  out([{ number: 42, title: "Add loud option to greet", url: "https://github.com/acme/widgets/pull/42", state: "OPEN", statusCheckRollup: [{ conclusion: "SUCCESS" }, { conclusion: "FAILURE" }, { status: "IN_PROGRESS" }, { state: "SUCCESS" }] }]);
} else if (args[0] === "api" && args[1] === "graphql") {
  const body = JSON.parse(stdin);
  const op = /(?:query|mutation)\s+(\w+)/.exec(body.query)?.[1] ?? "";
  if (body.query.trimStart().startsWith("mutation")) {
    mutate(op, body.variables.input ?? {});
    out({ data: {} });
  } else {
    const reply = {
      PrViewer: { viewer: data.viewer },
      PrRepoParent: { repository: { parent: null } },
      PrList: data.list,
      PrDetail: detail(),
      PrViewed: viewed(),
      PrCheckoutInfo: data.checkoutInfo,
    }[op];
    if (op === "PrDeleteBranchInfo") {
      const pr = detail().repository.pullRequest;
      out({ data: { repository: { pullRequest: { state: pr.state, headRefName: pr.headRefName, headRef: pr.headRef, headRepository: { defaultBranchRef: pr.headRepository.defaultBranchRef } } } } });
      process.exit(0);
    }
    out({ data: reply ?? {} });
  }
} else if (args.includes("--slurp")) {
  out([data.files]);
} else if (args.includes("-X") && args.includes("POST") && /pulls\/\d+\/comments( |$)/.test(args.join(" "))) {
  const input = JSON.parse(stdin);
  state.threads.push({ id: `RT_new_${++state.seq}`, path: input.path, isResolved: false, isOutdated: false, line: input.line, originalLine: input.line, startLine: input.start_line ?? null, originalStartLine: input.start_line ?? null, diffSide: input.side, startDiffSide: input.start_side ?? null, viewerCanResolve: true, viewerCanUnresolve: false, comments: { nodes: [comment(input.body, false)] } });
  save();
  out({ id: 1 });
} else {
  out({ id: 1 });
}
