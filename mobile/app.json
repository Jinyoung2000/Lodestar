{
  "expo": {
    "name": "Lodestar",
    "slug": "lodestar-mobile",
    "scheme": "lodestar",
    "version": "0.2.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.gene.lodestar-mobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Lodestar connects to your Mac on the same network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "LodestarSymbols",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/material-symbols/400Regular/MaterialSymbols_400Regular.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Lodestar uses the camera to scan the pairing QR code and to attach photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lodestar attaches the photos you choose to your message.",
          "cameraPermission": "Lodestar uses the camera to attach photos."
        }
      ],
      "./plugins/android-release"
    ],
    "android": {
      "package": "com.utillo.lodestar",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#1f1f1f",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff",
        "dark": {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#181818"
        }
      }
    },
    "extra": {
      "eas": {
        "projectId": "d3b0ee81-7438-4fa8-a3ec-e39af42eac08"
      }
    },
    "owner": "jinzero",
    "updates": {
      "url": "https://u.expo.dev/d3b0ee81-7438-4fa8-a3ec-e39af42eac08",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
