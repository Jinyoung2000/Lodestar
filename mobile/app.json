{
  "expo": {
    "name": "Lodestar",
    "slug": "lodestar-mobile",
    "scheme": "lodestar",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.gene.lodestar-mobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Lodestar connects to your Mac on the same network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Lodestar uses the camera to scan the pairing QR code and to attach photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lodestar attaches the photos you choose to your message.",
          "cameraPermission": "Lodestar uses the camera to attach photos."
        }
      ],
      "./plugins/android-release"
    ],
    "android": {
      "package": "dev.gene.lodestar",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#1f1f1f",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ]
    }
  }
}
